PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vyapaarscore
JWT_SECRET=your_jwt_secret_key_here

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="VyapaarScore Verification" <your_email@gmail.com>

HIDE_DEV_OTP=true
